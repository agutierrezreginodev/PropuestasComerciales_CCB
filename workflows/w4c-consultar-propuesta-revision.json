        -608,
        0
      ],
      "webhookId": "5a89df4f-821b-4066-9e14-82cece0fb106",
      "credentials": {
        "httpHeaderAuth": {
          "id": "jYGowZ6DBd6wkxBL",
          "name": "HeaderAuth - Consultar Propuesta (W4C)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = ($json.query && $json.query.id_solicitud) || '';\nreturn { json: { id_solicitud: id } };"
      },
      "id": "a1b2c3d4-2222-4a22-8a22-000000000002",
      "name": "Extraer id_solicitud de la query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const idSolicitud = $('Extraer id_solicitud de la query').first().json.id_solicitud;\nif (!idSolicitud) {\n  throw new Error('Falta id_solicitud en la consulta.');\n}\n\nconst ctx = $('Ejecutar Leer Contexto Propuesta').first().json || {};\nconst q = ctx.cotizacion || {};\nconst c = ctx.criterios || {};\nconst s = ctx.solicitud || {};\n\nif (!q || !q.id_solicitud) {\n  return { json: { ok: false, error: 'No se encontró la propuesta solicitada.' } };\n}\n\nreturn { json: {\n  ok: true,\n  id_solicitud: q.id_solicitud,\n  nombre_cliente: s.nombre_cliente || c.nombre_solicitante || '',\n  razon_social: c.razon_social || '',\n  servicio: q.servicio || c.servicio || '',\n  total_registros: q.total_registros,\n  valor_total: q.valor_total,\n  pdf_url: q.pdf_url || null,\n  ronda_correccion: Number(q.ronda_correccion) || 0,\n  estado: q.estado || ''\n} };"
      },
      "id": "a1b2c3d4-2222-4a22-8a22-000000000006",
      "name": "Consolidar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        -112
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-2222-4a22-8a22-000000000007",
      "name": "Responder consulta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        896,
        -128
      ]
    },
    {
