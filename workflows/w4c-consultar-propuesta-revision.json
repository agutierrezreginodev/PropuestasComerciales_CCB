    {
      "id": "a1b2c3d4-2222-4a22-8a22-000000000006",
      "name": "Consolidar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const idSolicitud = $('Extraer id_solicitud de la query').first().json.id_solicitud;\nif (!idSolicitud) {\n  throw new Error('Falta id_solicitud en la consulta.');\n}\n\nconst q = $('Leer cotización').first().json || {};\nconst c = $('Leer criterios').first().json || {};\nconst s = $('Leer solicitud').first().json || {};\n\nif (!q || !q.id_solicitud) {\n  return { json: { ok: false, error: 'No se encontró la propuesta solicitada.' } };\n}\n\nreturn { json: {\n  ok: true,\n  id_solicitud: q.id_solicitud,\n  nombre_cliente: s.nombre_cliente || c.nombre_solicitante || '',\n  razon_social: c.razon_social || '',\n  servicio: q.servicio || c.servicio || '',\n  total_registros: q.total_registros,\n  valor_total: q.valor_total,\n  pdf_url: q.pdf_url || null,\n  ronda_correccion: Number(q.ronda_correccion) || 0,\n  estado: q.estado || ''\n} };"
      }
    },
