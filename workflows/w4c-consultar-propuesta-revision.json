  "name": "CCB · W4C — Consultar la propuesta para revisión",
  "description": "W4C — Consultar Propuesta para Revision. API de solo lectura (webhook GET, Header Auth + CORS restringido) consumida por la pagina externa de revision (revision-propuesta-ccb) para mostrar el resumen de la propuesta antes de decidir. Area propietaria: Servicios de Informacion - CCB.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "path": "consultar-propuesta",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
