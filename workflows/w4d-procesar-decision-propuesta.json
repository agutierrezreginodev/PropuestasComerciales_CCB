      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Ejecutar Leer Contexto Propuesta').first().json || {};\nconst q = ctx.cotizacion || {};\nconst c = ctx.criterios || {};\nconst s = ctx.solicitud || {};\nconst entrada = $('Extraer decisión del body').first().json;\nconst { id: _qi, createdAt: _qc, updatedAt: _qu, ...quote } = q;\nconst { id: _ci, createdAt: _cc, updatedAt: _cu, ...criterios } = c;\nconst { id: _si, createdAt: _sc, updatedAt: _su, ...solicitud } = s;\nreturn { json: {\n  id_solicitud: quote.id_solicitud || criterios.id_solicitud || entrada.id_solicitud,\n  servicio: quote.servicio || criterios.servicio || '',\n  estado: quote.estado || '',\n  total_registros: quote.total_registros,\n  valor: quote.valor, iva: quote.iva, valor_total: quote.valor_total,\n  pdf_url: quote.pdf_url || null,\n  ronda_correccion: Number(quote.ronda_correccion) || 0,\n  nombre_cliente: solicitud.nombre_cliente || criterios.nombre_solicitante || '',\n  razon_social: criterios.razon_social || '',\n  email_cliente: solicitud.email_cliente || '',\n  criterios, solicitud,\n  Decision: entrada.Decision,\n  Comentario: entrada.Comentario\n} };"
