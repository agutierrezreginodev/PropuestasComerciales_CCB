    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fresh = $json;\nconst idSolicitud = fresh.id_solicitud;\nconst rondaGuardada = Number(fresh.ronda_correccion) || 0;\nconst link = 'https://revision-propuesta-ccb.vercel.app/?id_solicitud=' + encodeURIComponent(idSolicitud);\nconst mensaje = '📋 <b>Propuesta actualizada — ronda ' + rondaGuardada + ' de 3</b><br><br>'\n  + 'Solicitud: ' + idSolicitud + '<br><br>'\n  + '<a href=\"' + link + '\">👉 Ver y decidir</a>';\nreturn { json: { id_solicitud: idSolicitud, mensaje_teams: mensaje } };"
