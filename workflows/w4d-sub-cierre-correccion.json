    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\n// F6-03: enmascara PII y datos sensibles del texto libre antes de registrarlo o alertarlo.\nconst limpiar = (t) => String(t === null || t === undefined ? '' : t)\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '<correo>')\n  .replace(/https?:\\/\\/\\S+/g, '<url>')\n  .replace(/\\b\\d{7,}\\b/g, '<num>');\nconst flujo = $workflow.name;\nconst esExcepcion = typeof j.ok === 'undefined';\nconst nodoFallido = 'Re-invocar motor' + (esExcepcion ? '' : ' (recálculo)');\nconst tipoError = esExcepcion\n  ? 'Excepción al re-invocar el motor de cálculo (W3)'\n  : 'Rechazo del motor de cálculo (ok=false)';\n// F4-03: el id viaja en el item (lo conserva 'Preservar contexto de la corrección').\nconst id = j.id_solicitud || '';\nconst mensaje = limpiar((typeof j.error === 'string' ? j.error : (j.error && j.error.message)) || j.message || (esExcepcion ? 'Error desconocido al re-invocar el motor' : 'El recálculo devolvió ok=false')).slice(0, 300);\nconst descripcion = esExcepcion\n  ? 'La corrección con IA se aplicó pero la re-invocación del motor de cálculo falló con una excepción (no se obtuvo respuesta). La propuesta quedó en ERROR_CALCULO y no se reintenta automáticamente.'\n  : 'La corrección con IA se aplicó pero el motor rechazó el recálculo (ok=false). La propuesta quedó en ERROR_CALCULO y no se reintenta automáticamente.';\nconst fechaError = DateTime.now().setZone('America/Bogota').toFormat('yyyy-MM-dd HH:mm:ss');\nconst emailBody = `<!DOCTYPE html>\n<html lang=\"es\"><head><meta charset=\"UTF-8\"></head>\n<body style=\"margin:0;padding:0;background-color:#F2F5F9;font-family:Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#F2F5F9\"><tr><td align=\"center\" style=\"padding:32px 16px;\">\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#FFFFFF\" style=\"max-width:600px;border-radius:12px;overflow:hidden;\">\n<tr><td bgcolor=\"#001489\" align=\"center\" style=\"padding:28px 40px;\">\n<p style=\"font-size:11px;font-weight:600;color:rgba(255,255,255,0.65);text-transform:uppercase;letter-spacing:3px;margin:0;\">Servicios de Información</p>\n</td></tr>\n<tr><td bgcolor=\"#D64545\" align=\"center\" style=\"padding:11px 32px;\">\n<p style=\"font-size:12px;font-weight:700;color:#FFFFFF;text-transform:uppercase;letter-spacing:2px;margin:0;\">⚠️ Recálculo falló — propuesta en ERROR_CALCULO</p>\n</td></tr>\n<tr><td bgcolor=\"#FFFFFF\" style=\"padding:32px 40px;\">\n<p style=\"font-size:14px;color:#404e4f;margin:0 0 16px 0;line-height:1.7;\">${descripcion}</p>\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">Flujo:</strong> ${flujo}</p>\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">Tipo de error:</strong> ${tipoError}</p>\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">Nodo fallido:</strong> ${nodoFallido}</p>\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">Mensaje de error:</strong> ${mensaje}</p>\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">ID solicitud:</strong> ${id}</p>\n<p style=\"font-size:13px;color:#212120;margin:0;\"><strong style=\"color:#001489;\">Fecha:</strong> ${fechaError}</p>\n</td></tr>\n</table></td></tr></table></body></html>`;\nreturn { json: { id_solicitud: id, flujo, tipo_error: tipoError, workflow_origen: 'W4-D-decision-propuesta', nodo_fallido: nodoFallido, mensaje_error: mensaje, fecha_error: fechaError, emailBody } };"
      },
