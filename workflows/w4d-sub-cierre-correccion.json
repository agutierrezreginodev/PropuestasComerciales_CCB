    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\n// F6-03: enmascara PII y datos sensibles del texto libre antes de registrarlo o alertarlo.\nconst limpiar = (t) => String(t === null || t === undefined ? '' : t)\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '<correo>')\n  .replace(/https?:\\/\\/\\S+/g, '<url>')\n  .replace(/\\b\\d{7,}\\b/g, '<num>');\nconst mensaje = limpiar((j.error && (j.error.message || j.error.description)) || 'Fallo técnico al enviar el mensaje de Teams').slice(0, 300);\nconst get = (name) => { try { return $(name).first().json || {}; } catch (e) { return {}; } };\n// F4-03: el id venia de 'Consolidar datos y decision' (nodo de W4-D); ahora se resuelve dentro del subflujo.\nconst id = get('Data Table - Releer cotización').id_solicitud || $json.id_solicitud || '';\nreturn { json: { id_solicitud: id, workflow_origen: 'W4-D-decision-propuesta', nodo_fallido: 'Teams - Enviar mensaje (corrección)', mensaje_error: mensaje } };"
      },
