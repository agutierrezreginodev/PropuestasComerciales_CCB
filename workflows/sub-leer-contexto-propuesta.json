    {
      "parameters": {
        "jsCode": "// Devuelve las tres lecturas en un solo item, siempre con la misma forma (aunque falte alguna).\nconst get = (name) => { try { return $(name).first().json || {}; } catch (e) { return {}; } };\nconst id = get('Resolver id_solicitud').id_solicitud || '';\nreturn { json: { id_solicitud: id, cotizacion: get('Data Table - Leer cotización'),\n                 criterios: get('Data Table - Leer criterios'), solicitud: get('Data Table - Leer solicitud') } };"
      },
