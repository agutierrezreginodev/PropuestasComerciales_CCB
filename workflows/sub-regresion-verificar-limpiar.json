    {
      "parameters": {
        "jsCode": "// Verifica el ESTADO REAL en las tablas (no lo que devolvieron los subflujos).\nconst leer = (nombre) => { try { return $(nombre).all().map((i) => i.json); } catch (e) { return []; } };\nconst cot = leer('Data Table - Leer cotizaciones');\nconst sol = leer('Data Table - Leer solicitudes');\nconst err = leer('Data Table - Leer errores');\nconst casos = [\n  { caso: 'aprobar',  id: 'SOL-PRUEBA-REGRESION-APROBAR',  esperado: 'APROBADA' },\n  { caso: 'cancelar', id: 'SOL-PRUEBA-REGRESION-CANCELAR', esperado: 'CANCELADA' },\n  { caso: 'revision', id: 'SOL-PRUEBA-REGRESION-REVISION', esperado: 'REVISION_MANUAL' },\n  { caso: 'error',    id: 'SOL-PRUEBA-REGRESION-ERROR',    esperado: 'fila en Errores_CCB con error_timestamp' },\n  { caso: 'envio',    id: 'SOL-PRUEBA-REGRESION-ENVIO',    esperado: 'ENVIADA en cotizacion y solicitud' },\n  { caso: 'motor',    id: 'SOL-PRUEBA-REGRESION-MOTOR',    esperado: 'PROPUESTA_GENERADA con total_registros>0, valor_total>0 y pdf_url' },\n];\nconst filas = casos.map((c) => {\n  if (c.caso === 'error') {\n    const f = err.find((r) => r.id_solicitud === c.id) || {};\n    return { caso: c.caso, esperado: c.esperado, obtenido: f.error_timestamp ? 'fila con ' + f.error_timestamp : '(sin fila)', ok: !!f.error_timestamp };\n  }\n  const r = cot.find((x) => x.id_solicitud === c.id) || {};\n  if (c.caso === 'envio') {\n    const s = sol.find((x) => x.id_solicitud === c.id) || {};\n    const ok = r.estado === 'ENVIADA' && !!r.fecha_envio && s.estado === 'ENVIADA';\n    return { caso: c.caso, esperado: c.esperado, obtenido: 'cotizacion ' + (r.estado || '(sin fila)') + ' / solicitud ' + (s.estado || '(sin fila)'), ok };\n  }\n  if (c.caso === 'motor') {\n    const conError = err.some((e) => e.id_solicitud === c.id);\n    const total = Number(r.total_registros);\n    const valor = Number(r.valor_total);\n    const ok = r.estado === 'PROPUESTA_GENERADA' && total > 0 && valor > 0 && !!r.fecha_calculo && !!r.pdf_url && !conError;\n    const partes = [\n      'cotizacion ' + (r.estado || '(sin fila)'),\n      'total ' + (Number.isFinite(total) ? total : '(sin dato)'),\n      'valor_total ' + (Number.isFinite(valor) ? valor : '(sin dato)'),\n      'pdf ' + (r.pdf_url ? 'si' : 'no'),\n    ];\n    if (conError) partes.push('ERROR registrado en Errores_CCB');\n    return { caso: c.caso, esperado: c.esperado, obtenido: partes.join(' / '), ok };\n  }\n  return { caso: c.caso, esperado: c.esperado, obtenido: r.estado || '(sin fila)', ok: r.estado === c.esperado };\n});\nconst fallos = filas.filter((f) => !f.ok).length;\nconst resumen = filas.map((f) => (f.ok ? 'OK    ' : 'FALLO ') + f.caso + ': esperado ' + f.esperado + ' / obtenido ' + f.obtenido).join('\\n');\nreturn [{ json: {\n  metrica: 'regresion_pipeline', valor: (filas.length - fallos) + '/' + filas.length, unidad: 'casos ok',\n  estado: fallos === 0 ? 'ok' : 'FALLO',\n  actualizado_en: DateTime.now().setZone('America/Bogota').toFormat('yyyy-MM-dd HH:mm:ss'),\n  filas, resumen,\n  subject: '[Regresion CCB] ' + (fallos === 0 ? 'ok' : 'FALLO') + ': ' + (filas.length - fallos) + '/' + filas.length + ' casos ok',\n  emailBody: '<p><b>Regresion del pipeline CCB</b></p><p>' + resumen.split('\\n').join('<br>') + '</p>',\n} }];"
      },
