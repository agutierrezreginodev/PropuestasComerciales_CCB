    {
      "id": "sub-error-trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -480,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "sub-error-normalizar",
      "name": "Normalizar entrada de error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Contrato de entrada del subflujo compartido de error.\n// Campos esperados del llamador: id_solicitud, workflow_origen, nodo_fallido, mensaje_error.\n// Opcionales: emailBody (HTML), subject, alertar (bool).\nconst j = $json;\nconst nodo = j.nodo_fallido || 'desconocido';\nconst id = j.id_solicitud || '';\nconst origen = j.workflow_origen || 'desconocido';\nconst mensaje = j.mensaje_error || 'Error sin mensaje';\nconst emailBody = j.emailBody || '<p>Error en <b>' + origen + '</b>.</p><ul><li><b>Nodo:</b> ' + nodo + '</li><li><b>Solicitud:</b> ' + id + '</li><li><b>Detalle:</b> ' + mensaje + '</li></ul>';\nconst subject = j.subject || ('[Propuesta CCB] Error en ' + origen + ' — ' + (id || 'sin id'));\nconst alertar = j.alertar !== false;\nreturn { json: { id_solicitud: id, workflow_origen: origen, nodo_fallido: nodo, mensaje_error: mensaje, emailBody, subject, alertar } };"
      }
    },
    {
      "id": "sub-error-if-alertar",
      "name": "¿Enviar alerta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.alertar }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "sub-error-registrar",
      "name": "Data Table - Registrar error",
