    {
      "parameters": {
        "jsCode": "// Filas de prueba de la regresion. Comparten 'servicio' para poder borrarlas de una sola vez.\n// Los ids son fijos: cada corrida reutiliza las mismas filas (upsert), la tabla no crece.\nconst casos = ['APROBAR', 'CANCELAR', 'REVISION', 'ERROR'];\nreturn casos.map((caso) => ({\n  json: {\n    id_solicitud: 'SOL-PRUEBA-REGRESION-' + caso,\n    servicio: 'SOL-PRUEBA-REGRESION',\n    total_registros: 100, valor: 100000, iva: 19000, valor_total: 119000,\n    estado: 'EN_REVISION', ronda_correccion: 0, comentario_fausto: '',\n  },\n}));"
