      "id": "8dd8f062-a559-4669-a994-04effaeb0e4b",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const execution = $json.execution || {};\nconst workflow = $json.workflow || {};\n\nconst workflowName = workflow.name || '(desconocido)';\nconst workflowId = workflow.id || '';\nconst executionId = execution.id || '';\nconst executionUrl = execution.url || '';\nconst lastNode = execution.lastNodeExecuted || '(desconocido)';\nconst errorType = execution.error?.name || execution.error?.type || 'Error desconocido';\nconst errorMessage = execution.error?.message || execution.error?.description || 'Sin mensaje de error';\nconst timestamp = execution.error?.timestamp\n  ? DateTime.fromMillis(execution.error.timestamp).setZone('America/Bogota').toFormat('yyyy-MM-dd HH:mm:ss')\n  : DateTime.now().setZone('America/Bogota').toFormat('yyyy-MM-dd HH:mm:ss');\n\nconst alertHtml = `<!DOCTYPE html>\n<html lang=\"es\"><head><meta charset=\"UTF-8\"></head>\n<body style=\"margin:0;padding:0;background-color:#F2F5F9;font-family:Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#F2F5F9\"><tr><td align=\"center\" style=\"padding:32px 16px;\">\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#FFFFFF\" style=\"max-width:600px;border-radius:12px;overflow:hidden;box-shadow:0 6px 32px rgba(0,20,137,0.14);\">\n<tr><td bgcolor=\"#001489\" align=\"center\" style=\"padding:32px 40px 28px 40px;background-image:linear-gradient(135deg,#001489 0%,#014392 60%,#009CDE 100%);\">\n<img src=\"https://prod.camarabaq.org.co/wp-content/uploads/2022/07/Logo-CCB-Blanco.png\" alt=\"CamaraBAQ\" width=\"140\" style=\"max-width:140px;margin:0 auto 14px auto;\" />\n<p style=\"font-size:11px;font-weight:600;color:rgba(255,255,255,0.65);text-transform:uppercase;letter-spacing:3px;margin:0;\">Servicios de Información</p>\n</td></tr>\n<tr><td bgcolor=\"#D64545\" align=\"center\" style=\"padding:11px 32px;\">\n<p style=\"font-size:12px;font-weight:700;color:#FFFFFF;text-transform:uppercase;letter-spacing:2px;margin:0;\">🔴 Falló una ejecución (catch-all)</p>\n</td></tr>\n<tr><td bgcolor=\"#FFFFFF\" style=\"padding:32px 40px 24px 40px;\">\n<p style=\"font-size:14px;color:#404e4f;margin:0 0 20px 0;line-height:1.7;\">Un workflow tuvo un fallo que no fue capturado por su manejo de errores interno. Detalles:</p>\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-radius:10px;overflow:hidden;border:1px solid #D9E2EC;\">\n<tr><td bgcolor=\"#001489\" style=\"padding:10px 20px;\"><p style=\"font-size:10px;font-weight:700;color:#009CDE;text-transform:uppercase;letter-spacing:2px;margin:0;\">Detalle del error</p></td></tr>\n<tr><td bgcolor=\"#F2F5F9\" style=\"padding:16px 20px;\">\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">Flujo:</strong> ${workflowName} (ID: ${workflowId})</p>\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">Tipo de error:</strong> ${errorType}</p>\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">Nodo donde falló:</strong> ${lastNode}</p>\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">Mensaje de error:</strong> ${errorMessage}</p>\n<p style=\"font-size:13px;color:#212120;margin:0 0 6px 0;\"><strong style=\"color:#001489;\">Ejecución:</strong> <a href=\"${executionUrl}\" style=\"color:#3482FE;\">${executionId}</a></p>\n<p style=\"font-size:13px;color:#212120;margin:0;\"><strong style=\"color:#001489;\">Fecha:</strong> ${timestamp}</p>\n</td></tr></table>\n</td></tr>\n<tr><td bgcolor=\"#014392\" style=\"padding:24px 40px;\">\n<p style=\"font-size:11px;color:rgba(255,255,255,0.45);margin:0;line-height:1.5;\">Alerta generada automáticamente por el sistema de propuestas comerciales de CamaraBAQ.</p>\n</td></tr>\n</table></td></tr></table></body></html>`;\n\nreturn {\n  json: {\n    workflowName,\n    workflowId,\n    errorType,\n    lastNode,\n    errorMessage,\n    executionId,\n    executionUrl,\n    timestamp,\n    alertHtml\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        0
      ],
      "id": "0f0280a2-e6da-4b2b-bacb-ca39bfc91a27",
