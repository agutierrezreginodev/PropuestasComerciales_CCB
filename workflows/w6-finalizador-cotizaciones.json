      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\nfor (const item of items) {\n  const fecha = item.json.fecha_envio;\n  if (!fecha) continue;\n  const dias = DateTime.now().diff(DateTime.fromISO(fecha), 'days').days;\n  if (dias >= 30) {\n    result.push({ json: { ...item.json, dias_desde_envio: Math.floor(dias) } });\n  }\n}\nreturn result;"
      },
