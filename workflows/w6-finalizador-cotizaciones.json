        "jsCode": "const j = $json;\nconst nodo = (j.node && j.node.name) || 'Marcar FINALIZADA';\nconst mensaje = (j.error && (j.error.message || j.error.description)) || 'Error desconocido en el finalizador W6';\nconst id = j.id_solicitud || 'N/A';\nconst emailBody = '<p>Error en <b>W6 (Finalizador de Cotizaciones)</b>. La fila puede haber quedado a mitad de camino — revisar manualmente.</p><ul><li><b>Nodo:</b> ' + nodo + '</li><li><b>Solicitud:</b> ' + id + '</li><li><b>Detalle:</b> ' + mensaje + '</li></ul>';\nreturn { json: { id_solicitud: id, workflow_origen: 'W6-finalizador', nodo_fallido: nodo, mensaje_error: mensaje, emailBody } };"
